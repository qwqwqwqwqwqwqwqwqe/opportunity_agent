FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
COPY pyproject.toml README.md ./
COPY opportunity_agent/__init__.py ./opportunity_agent/__init__.py
# Install the explicit CPU wheel first; rag then reuses this torch installation.
RUN python -m pip install --no-cache-dir --index-url "$PIP_INDEX_URL" --upgrade pip \
    && python -m pip install --no-cache-dir --index-url "$TORCH_CPU_INDEX_URL" "torch==2.8.0" \
    && python -m pip install --no-cache-dir --index-url "$PIP_INDEX_URL" ".[v2,resume,rag,observability]" \
    && python -c "import torch, sentence_transformers; assert torch.version.cuda is None, 'Expected CPU-only PyTorch'"
COPY opportunity_agent ./opportunity_agent
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic
COPY data/university_domains.json ./data/university_domains.json
CMD ["python", "-m", "opportunity_agent.v2.agents.a2a", "research", "--host", "0.0.0.0", "--advertised-host", "research", "--backend", "python"]
